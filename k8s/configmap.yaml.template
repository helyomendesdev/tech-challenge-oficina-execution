apiVersion: v1
kind: ConfigMap
metadata:
  name: execution-service-config
data:
  AWS_REGION: "${AWS_REGION}"
  EXECUTION_COMMANDS_QUEUE_URL: "${EXECUTION_COMMANDS_QUEUE_URL}"
  SAGA_RESPONSES_QUEUE_URL: "${SAGA_RESPONSES_QUEUE_URL}"
  EXECUTION_DYNAMODB_TABLE: "${EXECUTION_DYNAMODB_TABLE}"
  EXECUTION_LOG_LEVEL: "${EXECUTION_LOG_LEVEL}"
  EXECUTION_VISIBILITY_TIMEOUT_SECONDS: "${EXECUTION_VISIBILITY_TIMEOUT_SECONDS}"
  EXECUTION_SQS_WAIT_TIME_SECONDS: "${EXECUTION_SQS_WAIT_TIME_SECONDS}"
  EXECUTION_SQS_ERROR_BACKOFF_SECONDS: "${EXECUTION_SQS_ERROR_BACKOFF_SECONDS}"
  EXECUTION_OUTBOX_POLL_INTERVAL_SECONDS: "${EXECUTION_OUTBOX_POLL_INTERVAL_SECONDS}"
