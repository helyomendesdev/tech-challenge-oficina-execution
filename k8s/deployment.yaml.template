apiVersion: apps/v1
kind: Deployment
metadata:
  name: execution-service
  labels:
    app.kubernetes.io/name: execution-service
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: execution-service
  template:
    metadata:
      labels:
        app.kubernetes.io/name: execution-service
    spec:
      serviceAccountName: "${K8S_SERVICE_ACCOUNT}"
      terminationGracePeriodSeconds: 60
      containers:
        - name: execution-service
          image: "${EXECUTION_IMAGE}"
          imagePullPolicy: IfNotPresent
          envFrom:
            - configMapRef:
                name: execution-service-config
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            runAsUser: 10001
            capabilities:
              drop:
                - ALL
